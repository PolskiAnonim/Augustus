{
  "manifest_version": 3,
  "name": "Augustus Helper",
  "version": "0.1",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://www.novelupdates.com/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.mangaupdates.com/*",
        "https://www.novelupdates.com/*",
        "https://steamdb.info/*"
      ],
      "js": [
        "content-script.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "skiko.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}